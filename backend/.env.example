# Copy to backend/.env (gitignored) for local runs. On Vercel, set these as project environment variables.
GEMINI_API_KEY=your-gemini-api-key

# Progress storage on Vercel (its filesystem is temporary). Add Turso from the Vercel Marketplace
# or create a database at turso.tech; these two variables connect it.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=...

# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest   # tried in order
# EXAM_DB=C:/path/outside/onedrive/exam.db                  # local SQLite location
