# Copy to backend/.env (gitignored) and fill in.
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest   # tried in order; next one takes over if a model is busy
# EXAM_DB=C:/path/outside/onedrive/exam.db                  # where the SQLite question bank lives
# DATASET_DIR=../data/source                                # local checkout of the question dataset
